# Copy to .env (Git ignores it). FlowPilot reads these at start-up.

# Where GarageFlow runs. Local .NET API: http://localhost:5080   Sandbox (fake GarageFlow): http://localhost:5090
GARAGEFLOW_BASE_URL=http://localhost:5080

# A GarageFlow user for FlowPilot to sign in as. Week 1 only reads, so an Advisor is enough;
# the audit-log tool needs an Admin. Demo users exist only when GarageFlow runs in Development.
GARAGEFLOW_EMAIL=advisor@garageflow.local
GARAGEFLOW_PASSWORD=Garage@12345

# Optional
GARAGEFLOW_TIMEOUT_SECONDS=10
GARAGEFLOW_MAX_RETRIES=3
SHOP_TIMEZONE=Asia/Kolkata
