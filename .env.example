# Copy to .env (Git ignores it). FlowPilot reads these at start-up.

# Where GarageFlow runs. Local .NET API: http://localhost:5080   Sandbox (fake GarageFlow): http://localhost:5090
GARAGEFLOW_BASE_URL=http://localhost:5080

# A GarageFlow user for FlowPilot to sign in as. Week 1 only reads, so an Advisor is enough;
# the audit-log tool needs an Admin. Demo users exist only when GarageFlow runs in Development.
GARAGEFLOW_EMAIL=advisor@garageflow.local
GARAGEFLOW_PASSWORD=Garage@12345

# Optional
GARAGEFLOW_TIMEOUT_SECONDS=10
GARAGEFLOW_MAX_RETRIES=3
SHOP_TIMEZONE=Asia/Kolkata

# ---- Week 2: knowledge base and logs (all optional; the defaults work offline)
KNOWLEDGE_DIR=knowledge
# hash (no model, offline) | ollama (local model) | openai (any OpenAI-compatible embeddings API)
EMBEDDINGS_PROVIDER=hash
# EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_URL=http://localhost:11434
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# memory (rebuilt at start-up) | pgvector (PostgreSQL; needs: uv sync --extra postgres, docker compose up -d postgres)
VECTOR_STORE=memory
# DATABASE_URL=postgresql://flowpilot:flowpilot@localhost:5433/flowpilot
# GarageFlow's console log. Sandbox: sandbox-logs/garageflow.log   Real: docker logs -t garageflow-api > logs/garageflow.log 2>&1
GARAGEFLOW_LOG_FILE=sandbox-logs/garageflow.log
